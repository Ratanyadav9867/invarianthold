# InvariantHold Environment Configuration
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
PROJECT_NAME="InvariantHold"
VERSION="1.0.0"
ENV="development"
DATABASE_URL="sqlite:///./invarianthold.db"

# Security & JWT
# Generate with: openssl rand -hex 32
# Required in production; auto-generated (ephemeral, logged to stdout) in development if omitted.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"

# Demo Simulation Defaults
DEFAULT_PACKET_COUNT=1000

# DEMO ONLY Credentials (seeded into DB with bcrypt hashes on first run)
# For development/hackathon demo testing only. NEVER use in production.
ADMIN_USER="admin@invarianthold.io"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
ANALYST_USER="analyst@invarianthold.io"
ANALYST_PASSWORD="CHANGE_ME_ANALYST_PASSWORD"
VIEWER_USER="viewer@invarianthold.io"
VIEWER_PASSWORD="CHANGE_ME_VIEWER_PASSWORD"

# Optional GenAI LLM Connector (Fallback rule engine works offline with zero keys)
# OPENAI_API_KEY="sk-..."
