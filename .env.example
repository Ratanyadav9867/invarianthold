# InvariantHold Environment Configuration
PROJECT_NAME="InvariantHold"
VERSION="1.0.0"
ENV="development"
DATABASE_URL="sqlite:///./invarianthold.db"

# Security & JWT
SECRET_KEY="REDACTED_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Simulation Defaults
DEFAULT_PACKET_COUNT=1000

# Demo Credentials (Seeded into DB with bcrypt hashes)
ADMIN_USER="admin@invarianthold.io"
ADMIN_PASSWORD="REDACTED_PASSWORD"
ANALYST_USER="analyst@invarianthold.io"
ANALYST_PASSWORD="REDACTED_PASSWORD"
VIEWER_USER="viewer@invarianthold.io"
VIEWER_PASSWORD="REDACTED_PASSWORD"

# Optional GenAI LLM Connector (Fallback rule engine works offline with zero keys)
# OPENAI_API_KEY="sk-..."
